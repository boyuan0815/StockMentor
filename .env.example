COMPOSE_PROJECT_NAME=stockmentor
DOCKERHUB_NAMESPACE=your-dockerhub-username
MYSQL_DATABASE=stockmentor
MYSQL_USER=stockmentor_user
MYSQL_PASSWORD=replace-with-secure-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-secure-root-password
STOCKMENTOR_ADMIN_TOKEN=replace-with-admin-token
STOCKMENTOR_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
OPENAI_API_KEY=replace-with-openai-api-key
TWELVEDATA_API_KEY=replace-with-twelve-data-api-key
OPENAI_MODEL=gpt-4o-mini
SPRING_JPA_HIBERNATE_DDL_AUTO=update
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
IMAGE_TAG=latest
